<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Switchboard.Cli</PackageId>
    <Title>Switchboard CLI</Title>
    <Description>Command-line interface for Switchboard feature management. Install as a global tool: dotnet tool install -g Switchboard.Cli. Evaluate flags and compute rollout buckets from your terminal or CI.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>switchboard</ToolCommandName>
    <RootNamespace>Switchboard.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switchboard.Sdk\Switchboard.Sdk.csproj" />
  </ItemGroup>

</Project>