<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Switchboard.Cli</PackageId>
    <Title>Switchboard CLI</Title>
    <Description>Command-line interface for Switchboard feature management. Install as a global tool: dotnet tool install -g Switchboard.Cli. Placeholder release reserving the package ID.</Description>

    <!-- Ship as a .NET global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>switchboard</ToolCommandName>
    <RootNamespace>Switchboard.Cli</RootNamespace>
  </PropertyGroup>

</Project>
